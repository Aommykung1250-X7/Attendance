# คัดลอกเป็น backend/.env สำหรับรันบนเครื่องตัวเอง (pnpm dev)

NODE_ENV=development
PORT=5292
HOST=127.0.0.1

# Postgres บนเครื่อง หรือรัน: docker compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgresql://attendance:attendance@localhost:5433/attendance

# สุ่มยาวอย่างน้อย 32 ตัว: openssl rand -hex 32
SESSION_SECRET=change-me-change-me-change-me-change-me

# Google Auth Platform → Clients → Web application
# Authorized redirect URI สำหรับเครื่องตัวเอง: http://localhost:5290/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ที่อยู่ที่เปิดเว็บ (ตอนพัฒนาคือ Vite dev server ซึ่งส่ง /api ต่อมาที่ backend)
APP_ORIGIN=http://localhost:5290
# GOOGLE_REDIRECT_URI=  (ไม่ต้องใส่ ค่าเริ่มต้นคือ APP_ORIGIN/api/auth/google/callback)

# อีเมลแอดมิน คั่นด้วย comma
ADMIN_EMAILS=you@gmail.com

QR_TOKEN_TTL_SECONDS=30

# http://localhost ใช้ cookie แบบ Secure ไม่ได้ในบางเบราว์เซอร์ ปิดได้เฉพาะตอนพัฒนา
COOKIE_SECURE=false

# ล็อกอินโดยไม่ผ่าน Google: /api/auth/dev-login?email=... (ทำงานเฉพาะเมื่อ NODE_ENV ไม่ใช่ production)
DEV_LOGIN=true
