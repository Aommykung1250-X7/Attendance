# =================================================================
# ระบบเช็กชื่อเข้างาน - ค่าสำหรับ production
# คัดลอกเป็น .env.production บน VPS แล้วแก้ทุกค่าที่เขียนว่า CHANGE_ME
#   docker compose --env-file .env.production up -d --build
# =================================================================

# 1. โดเมนของระบบ (ต้องเป็น https และตรงกับที่ตั้งใน Google Cloud)
DOMAIN_URL=https://attendance.yourdomain.com

# 2. พอร์ตบนเครื่อง VPS (เปิดเฉพาะ 127.0.0.1 ให้ reverse proxy เรียก)
FRONTEND_PORT=4801
BACKEND_PORT=4802

# 3. ฐานข้อมูล PostgreSQL (อยู่ใน Docker network ไม่เปิดออก host)
#    รหัสผ่านใช้เฉพาะ a-z A-Z 0-9 เพราะถูกนำไปต่อเป็น URL
POSTGRES_DB=attendance_db
POSTGRES_USER=attendance_user
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_hex_24

# 4. กุญแจของ session และ QR token (สุ่มยาวอย่างน้อย 32 ตัว)
#    สร้างด้วย: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME

# 5. Google Auth Platform (console.cloud.google.com → Google Auth Platform → Clients)
#    ประเภท Web application, Authorized redirect URI = DOMAIN_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME

# 6. อีเมล Google ของแอดมิน คั่นด้วย comma (ไม่ต้องอยู่ในรายชื่อพนักงาน)
ADMIN_EMAILS=admin1@gmail.com,admin2@gmail.com

# 7. QR เปลี่ยนทุกกี่วินาที (ค่าเริ่มต้นตอนติดตั้งครั้งแรก หลังจากนั้นแก้ในหน้าตั้งค่า)
QR_TOKEN_TTL_SECONDS=30
